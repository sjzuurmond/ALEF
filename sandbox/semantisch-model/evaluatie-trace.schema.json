{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sjzuurmond/ALEF/sandbox/semantisch-model/evaluatie-trace.schema.json",
  "title": "ALEF evaluatie-trace",
  "description": "Runtime-waarden van EEN uitvoering van een semantisch regelmodel tegen EEN testgeval (instantiedata + rekendatum). Zijartefact, los van het model: waarden zijn gesleuteld op (instantie, node-id), waarbij node-id verwijst naar een 'id' in het model (semantisch-model.schema.json). Dit is de tegenhanger van de Debug*-laag (interpreter.debug / interpreter.timed.debug) die ALEF's eigen interpreter produceert. Paart met de rendering-segmenten uit het model via node-id (de linguistics 'origin'), zodat een UI waarden inline kan tonen, bv. 'de bmi [20,0]'.",
  "type": "object",
  "required": ["model", "testgeval", "rekendatum", "waarden"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "model": { "type": "string", "description": "Naam/verwijzing van het regelmodel waarvoor deze trace geldt." },
    "testgeval": { "type": "string", "description": "Naam van het TestGeval dat is uitgevoerd." },
    "rekendatum": { "type": "string", "format": "date", "description": "De datum waarop is gerekend; bepaalt geldige regelversies/parametersets en het samplen van tijdlijnen." },
    "instanties": {
      "type": "array",
      "description": "De objecten die in deze run bestaan (invoer + tijdens de run gecreëerd).",
      "items": {
        "type": "object",
        "required": ["id", "objecttype"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Instantie-identiteit, gebruikt als sleutel in 'waarden'." },
          "objecttype": { "type": "string", "description": "Verwijzing naar Objecttype.naam in het model." },
          "naam": { "type": "string" }
        }
      }
    },
    "waarden": {
      "type": "object",
      "description": "waarden[instantie-id][node-id] = de geëvalueerde waarde van die model-node voor die instantie. node-id is een 'id' uit het model (Selectie, Attribuut, expressie, ...).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/Waarde" }
      }
    },
    "afgevuurd": {
      "type": "array",
      "description": "Welke regelversies zijn gevuurd, per instantie (voor 'welke regel bepaalde deze waarde').",
      "items": {
        "type": "object",
        "required": ["regelversie"],
        "additionalProperties": false,
        "properties": {
          "regelversie": { "type": "string", "description": "Verwijzing naar RegelVersie.id in het model." },
          "instantie": { "type": "string" }
        }
      }
    },
    "consistentie": {
      "type": "array",
      "description": "Uitkomsten van ConsistentieRegels.",
      "items": {
        "type": "object",
        "required": ["regel", "consistent"],
        "additionalProperties": false,
        "properties": {
          "regel": { "type": "string", "description": "Verwijzing naar Regel.id / RegelVersie.id." },
          "instantie": { "type": "string" },
          "consistent": { "type": "boolean" }
        }
      }
    }
  },

  "$defs": {
    "Waarde": {
      "title": "Runtime-waarde",
      "description": "Getagd met 'soort'. Tegenhanger van de Debug*-concepten uit interpreter.debug / interpreter.timed.debug (DebugString/Bool/List/Empty/ObjectRef/Timed/Period ...).",
      "oneOf": [
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": {
            "soort": { "const": "getal" },
            "waarde": { "type": "string", "description": "Decimaal als string (behoud precisie; komma of punt)." },
            "eenheid": { "type": "string", "description": "Bv. 'kg', 'm', 'euro'. Toont in UI als 'de premie [100 euro]'." }
          }
        },
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": { "soort": { "const": "percentage" }, "waarde": { "type": "string" } }
        },
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": { "soort": { "const": "tekst" }, "waarde": { "type": "string" } }
        },
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": { "soort": { "const": "boolean" }, "waarde": { "type": "boolean" } }
        },
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": { "soort": { "const": "datum" }, "waarde": { "type": "string", "format": "date" } }
        },
        {
          "type": "object", "required": ["soort", "waarde"], "additionalProperties": false,
          "properties": {
            "soort": { "const": "enum" },
            "domein": { "type": "string" },
            "waarde": { "type": "string" }
          }
        },
        {
          "description": "DebugEmpty — geen waarde (leeg slot).",
          "type": "object", "required": ["soort"], "additionalProperties": false,
          "properties": { "soort": { "const": "leeg" } }
        },
        {
          "description": "DebugList — verzameling waarden.",
          "type": "object", "required": ["soort", "elementen"], "additionalProperties": false,
          "properties": {
            "soort": { "const": "lijst" },
            "elementen": { "type": "array", "items": { "$ref": "#/$defs/Waarde" } }
          }
        },
        {
          "description": "DebugObjectRef — verwijzing naar een instantie.",
          "type": "object", "required": ["soort", "instantie"], "additionalProperties": false,
          "properties": {
            "soort": { "const": "object" },
            "instantie": { "type": "string", "description": "Verwijzing naar instanties[].id." }
          }
        },
        {
          "description": "DebugTimed/DebugPeriod — tijdlijn-waardig slot: stuksgewijs-constante functie van tijd.",
          "type": "object", "required": ["soort", "perioden"], "additionalProperties": false,
          "properties": {
            "soort": { "const": "tijdlijn" },
            "perioden": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["waarde"],
                "additionalProperties": false,
                "properties": {
                  "van": { "type": "string", "format": "date" },
                  "tot": { "type": "string", "format": "date" },
                  "waarde": { "$ref": "#/$defs/Waarde" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
